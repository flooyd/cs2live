{
	"name": "cs2live",
	"version": "0.0.1",
	"private": true,
	"type": "module",
	"imports": {
		"#lib": "./src/lib/index.js",
		"#lib/*": "./src/lib/*"
	},
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"live": "node --env-file-if-exists=.env scripts/live.ts",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"lint": "prettier --check . && eslint .",
		"format": "prettier --write .",
		"test:unit": "vitest",
		"test": "vitest --run",
		"gsi:config": "node --env-file-if-exists=.env scripts/gsi-config.ts",
		"gsi:replay": "node --env-file-if-exists=.env scripts/replay-gsi.ts",
		"gsi:anonymise": "node scripts/anonymise-capture.ts",
		"gsi:fixtures": "node scripts/make-fixtures.ts",
		"demo:damage": "node scripts/demo-damage.ts",
		"verify:replay": "node --env-file-if-exists=.env scripts/verify-replay.ts",
		"db:generate": "drizzle-kit generate",
		"db:migrate": "drizzle-kit migrate",
		"db:studio": "drizzle-kit studio",
		"db:push": "drizzle-kit push",
		"db:seed": "node --env-file-if-exists=.env scripts/seed-dev-data.ts",
		"db:cleanup": "node --env-file-if-exists=.env scripts/cleanup-raw-payloads.ts",
		"auth:schema": "auth generate --config scripts/auth-schema.config.ts --output src/lib/server/db/auth.schema.ts --yes"
	},
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"@sveltejs/adapter-node": "^6.0.5",
		"@sveltejs/adapter-vercel": "^7.0.3",
		"@sveltejs/kit": "^3.2.0",
		"@sveltejs/vite-plugin-svelte": "^7.3.1",
		"@types/node": "^24",
		"@types/unbzip2-stream": "^1.4.3",
		"@vitest/browser-playwright": "^5.1.0",
		"auth": "^1.7.25",
		"better-auth": "^1.7.25",
		"drizzle-kit": "^0.31.11",
		"drizzle-orm": "^0.45.4",
		"eslint": "^10.15.0",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.24.1",
		"globals": "^17.14.0",
		"playwright": "^1.65.1",
		"postgres": "^4.1.1",
		"prettier": "^3.10.1",
		"prettier-plugin-svelte": "^4.1.1",
		"svelte": "^5.57.3",
		"svelte-check": "^4.7.8",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.72.2",
		"vite": "^8.3.8",
		"vitest": "^5.1.0",
		"vitest-browser-svelte": "^3.1.0"
	},
	"dependencies": {
		"@akiver/boiler-writter": "^1.7.0",
		"@laihoe/demoparser2": "^0.42.3",
		"unbzip2-stream": "^1.4.3",
		"zod": "^4.6.7"
	}
}
