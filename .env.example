# ─── Database (Neon) ─────────────────────────────────────────────────────────
# Set on the Vercel site. Locally, set it only if this copy should write straight to the
# database (the site owner). Friends leave it empty and upload through the site instead.
# Neon needs SSL, so keep ?sslmode=require. The pooled endpoint (host contains "-pooler") is
# fine for the app; migrations use DATABASE_URL_UNPOOLED (the direct endpoint) when it is set.
DATABASE_URL="postgresql://user:password@ep-example-123456-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require"
DATABASE_URL_UNPOOLED="postgresql://user:password@ep-example-123456.us-east-2.aws.neon.tech/neondb?sslmode=require"

# The app's base URL: http://localhost:5173 locally, your Vercel URL on the site.
ORIGIN="http://localhost:5173"

# ─── Accounts (better-auth, only where DATABASE_URL is set) ──────────────────
# 32+ random characters, e.g. `node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"`
BETTER_AUTH_SECRET=""
# Who may create an account on the site: comma-separated emails, or * for anyone.
# Empty = only the first account (you).
SIGNUP_ALLOWLIST=""

# ─── Live tracking (local) ───────────────────────────────────────────────────
# Shared secret CS2 sends with every GSI post. `yarn gsi:config` generates it if empty.
GSI_TOKEN=""
# Where CS2 posts. Must match the port `yarn dev` / `yarn live` listen on.
GSI_URL="http://127.0.0.1:5173/api/gsi"
# 1 = append every GSI payload to captures/*.ndjson (see fixtures/README.md).
GSI_CAPTURE="0"
# GSI_CAPTURE_DIR="captures"
# Your SteamID64. Optional: /setup asks for it on first run.
# STEAM_ID=""
# The public site this copy uploads finished matches to, and your upload key from its
# account page. Both can also be entered on /setup instead.
CS2LIVE_SITE_URL=""
CS2LIVE_UPLOAD_KEY=""
# Seconds without in-match data before an unfinished match is saved as incomplete.
# INCOMPLETE_TIMEOUT_S="120"
# 1 = also store raw payloads in the raw_payloads table (direct database mode only).
STORE_RAW_PAYLOADS="0"
# Local folder for settings, the upload outbox and the generated GSI config.
# CS2LIVE_DATA_DIR=".cs2live"
# Force live tracking on/off. Default: on everywhere except Vercel.
# LIVE_TRACKING=""

# Database tests (part of yarn test) run against this database and TRUNCATE its tables, so
# never point it at real data; its name must contain "test". Leave empty to skip them.
# Any Postgres works, e.g. a local one or a separate Neon branch.
TEST_DATABASE_URL=
